# Supabase Frontend Credentials (Required for React App)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NOTE: The following secrets are NOT for the frontend .env file!
# They must be set directly in your Supabase Cloud environment using the CLI:
# npx supabase secrets set RESEND_API_KEY="your_resend_key"
# npx supabase secrets set LOCKER_API_SECRET="your_custom_hardware_password"
